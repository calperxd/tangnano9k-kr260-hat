(version 1)
# JLCPCB multilayer capabilities (jlcpcb.com/capabilities/pcb-capabilities, read 2026-10-21).
# Board-wide minimums in the project setup (0.1 mm track/clearance, 0.3 mm copper to edge) are tighter or equal.

(rule "JLC via hole to copper"
	(condition "A.Type == 'Via'")
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC PTH hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC NPTH to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC via hole to hole"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.2mm)))

(rule "JLC pad hole to hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.05mm)))

(rule "JLC PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

(rule "JLC minimum drill"
	(constraint hole_size (min 0.15mm)))

(rule "JLC minimum NPTH"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

# Board texts: 0.9 mm minimum so the J21 pin names fit between the board-edge pin row and the edge.
(rule "JLC silkscreen text"
	(layer "?.Silkscreen")
	(condition "(A.Type == 'Text' || A.Type == 'Text Box') && !A.memberOfFootprint('*')")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 0.9mm)))

# Designators: JLC's 1.0 mm is a legibility recommendation; 0.8 mm keeps them clear of the dense areas.
(rule "JLC silkscreen designators"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' && A.memberOfFootprint('*')")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 0.8mm)))


